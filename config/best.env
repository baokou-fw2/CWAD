# CWAD runtime settings. Sourced by scripts/common.sh, so every script in this
# repository sees these names. Only the variables the CWAD entry points read are
# listed: the recipe numbers of runs that no script here can reproduce (the
# inherited single-world baseline's batch/step counts, model and dataset family
# names, the resolution divisors) have been dropped.
#
# The manifest digest cannot be filled in by hand: it hashes
# provenance/source_files.sha256, so scripts/verify.py --check-source refuses to
# pass until that manifest is regenerated for this tree.
CWAD_SOURCE_MANIFEST_SHA256=TODO

# Student and teacher of the reported runs: Qwen3.5-4B distilled from a frozen
# Qwen3.5-9B (the CWAD (OPD) row), or from an EMA copy of itself (the CWAD row).
# The paths are deliberately empty -- they belong to whoever's machine this runs
# on, so point them at a local checkpoint directory or at a model id your
# transformers/vLLM install can resolve. train.sh refuses to start until the
# student path is set; an empty teacher path is the EMA self-teacher, not a
# missing value, so recipe 1 works with only the student set.
#
# The hidden sizes are checked before any weight is loaded, so they have to match
# the pair you actually point these at: 2560 is Qwen3.5-4B, 4096 is Qwen3.5-9B
# (scripts/verify.py pins the same default).
CWAD_STUDENT_MODEL_PATH=
CWAD_STUDENT_MODEL_HIDDEN_SIZE=2560
CWAD_TEACHER_MODEL_PATH=
CWAD_TEACHER_MODEL_HIDDEN_SIZE=4096

# Used instead of the student's own size when the teacher is the EMA copy rather
# than a separate checkpoint, i.e. for the non-cross-model arms.
CWAD_MODEL_HIDDEN_SIZE=2560

# Row counts verify.py can pin a build against. Left empty, every count check is
# skipped, so a deliberately filtered build (a QC-passed subset) trains without
# the guard aborting. Set them to your dataset's own counts to catch a build that
# silently lost rows.
CWAD_EXPECTED_ROWS=
CWAD_EXPECTED_MCQ_ROWS=
CWAD_EXPECTED_OPENQA_ROWS=

# The runtime training parquet: absolute image paths, one row per sample. Built
# from any dataset of that shape by ./run.sh build-data; train.sh also accepts
# --data-parquet. Left empty so a run has to say which build it means.
CWAD_DATA_PARQUET=

# The reported global batch size is 48; train.sh computes it as GPUS x
# PROMPTS_PER_RANK, so these two are the split this tree defaults to. The paper
# fixes the product, not the split: re-split it for your card count (--gpus N and
# 48/N prompts per rank) and the recipe stays the same.
CWAD_GPUS=8
CWAD_PROMPTS_PER_RANK=6
# Upstream verl defaults to flash_attention_2. If your box has no flash-attn build
# (and no nvcc to compile one, see scripts/prepare_env.sh --skip-kernels), keep
# this at sdpa, which is what the reference implementation ran with.
CWAD_ATTN_IMPLEMENTATION=sdpa
# Reported context lengths and rollout temperature. rollout group size (n) and the
# vLLM memory reservation are not in the paper's hyperparameter table, so they are
# left at the values this tree was developed on: n>1 makes the on-policy rollout
# branch, and the reservation has to leave the actor headroom for the teacher
# forward, which is all-gathered in full on every step. Tune those two per arm.
CWAD_CROSS_MAX_PROMPT_LENGTH=8192
CWAD_CROSS_MAX_RESPONSE_LENGTH=1024
CWAD_CROSS_ROLLOUT_N=2
CWAD_CROSS_ROLLOUT_TEMPERATURE=2.0
# Reported sampling: temperature 2.0, top-p 1.0.
CWAD_ROLLOUT_TOP_P=1.0
CWAD_CROSS_ROLLOUT_GPU_MEMORY_UTILIZATION=0.22
CWAD_CROSS_MAX_NUM_SEQS=4

# The machine-specific part lives here: model and dataset paths, row-count pins,
# the vLLM memory reservations and the image-pixel cap. The recipe values from the
# paper's table are stated here too, and the recipe launchers state the same ones
# at the top of their own file (scripts/run_cwad.sh, scripts/run_cwad_hint.sh), so
# neither place contradicts the other. A shell export still wins over both.
CWAD_LEARNING_RATE=2e-6
CWAD_WEIGHT_DECAY=1e-2
CWAD_LR_SCHEDULER=constant
CWAD_FREEZE_VISION_TOWER=False
CWAD_WARMUP_STEPS=10
# One epoch. train.sh pins trainer.total_epochs=1 and stops after this many
# optimizer steps, so it should be the step count of one pass over your build:
# rows / global batch, i.e. 2365 / 48 = 49 for the CWBench train split (verify.py
# prints the row count it checks). Raise it to train past one epoch, or pass
# --steps for a shorter run.
CWAD_TOTAL_STEPS=49
CWAD_TOPK=100
CWAD_ALPHA=1.0
CWAD_TEACHER_UPDATE_RATE=0.05
CWAD_SEED=42
# Also checkpoint mid-run so a late OOM still leaves usable weights; the final
# step is always saved regardless.
CWAD_CHECKPOINT_EVERY=25

# Cross-World Aligned Distillation: a counterfactual world B alongside the
# original world A. lambda weights the belief-transition term; tau is the softmax
# temperature over the centered log-prob difference.
CWAD_DUAL_WORLD=1
CWAD_LAMBDA=1.0
CWAD_TAU=1.0
CWAD_DUAL_WORLD_PROMPTS_PER_RANK=6
CWAD_DUAL_WORLD_ROLLOUT_N=1
# World B is the counterfactual edit at its native resolution, so its vision
# tokens sit in front of the question and (for the hinted arm) the reference
# solution. Same reported cap as the single-world arm.
CWAD_DUAL_WORLD_MAX_PROMPT_LENGTH=8192
CWAD_DUAL_WORLD_MAX_RESPONSE_LENGTH=1024
CWAD_DUAL_WORLD_ROLLOUT_TEMPERATURE=2.0
# Floor, not a preference: below ~0.15 vLLM fails engine init (a hidden OOM)
# because the student weights plus the engine's own overhead already consume most
# of the reservation, while a cross-model teacher needs the opposite -- a lower
# number, to leave the actor headroom. Tune per arm on your card.
CWAD_DUAL_WORLD_ROLLOUT_GPU_MEMORY_UTILIZATION=0.20
# World-B edits come at the editor's native resolution and the fallback rows keep
# the dataset's own resolution, which can be several megapixels; vision tokens
# scale with pixel area, so uncapped fallback rows produce sequences far longer
# than the rest of the batch and blow the actor's forward activation budget.
# Capped in verl/utils/dataset/vision_utils.py, which reads this variable.
CWAD_MAX_IMAGE_PIXELS=1048576
# The overlong-prompt filter re-decodes every image on every launch (a single CPU
# pass over the whole dataset, minutes on a large build).
# scripts/prefilter_prompts.py caches that verdict, so it is computed once and
# reused. Empty (the default) puts the cache under .runtime/; point it at a
# scratch directory with space, or override per run with --prefilter-cache-dir.
CWAD_PREFILTER_CACHE_DIR=

# Strict privileged CWAD: teacher sees world A at its own resolution, student
# sees world B at student resolution. Set both to the dataset column names for
# that variant; pass --no-privilege to ignore them.
CWAD_PRIV_TEACHER_A_KEY=teacher_world_a_images
CWAD_PRIV_STUDENT_B_KEY=student_world_b_images

CWAD_EVAL_MAX_TOKENS=4096
CWAD_EVAL_GPU_MEMORY_UTILIZATION=0.85
CWAD_EVAL_ENFORCE_EAGER=0
# The six judge-scored columns of the paper's table (V*Bench, HR-Bench 4K,
# RealWorldQA, MMVP, HallusionBench, SEED-Bench). OK-VQA is open-ended and does
# not go through the judge: score it with eval/score_okvqa.py over the answers
# eval/infer.py writes. CWBench's CWPA/CWFR are eval/run_cwbench.sh.
CWAD_EVAL_BENCHMARKS=vstar,hrbench-4k,realworldqa,mmvp,hallusionbench,seedbench
CWAD_JUDGE_TP=2
CWAD_JUDGE_MAX_TOKENS=64
CWAD_JUDGE_MAX_MODEL_LEN=65536
